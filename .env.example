# Copy to .env and edit. `docker compose` reads it automatically.

# --- how clients reach this server ------------------------------------------
# The public base URL. `t3-pair` builds pairing links from it, so it must be
# the address your phone or browser actually uses - not the container's.
T3_PUBLIC_URL=https://t3.example.com

# Hostname for the optional `tls` profile. Must resolve to this machine, and
# ports 80/443 must be reachable, so Caddy can issue a certificate.
T3_DOMAIN=t3.example.com

# Where to publish the server's own port. Loopback by default; the container
# speaks plain HTTP, so only widen this on a trusted network.
T3_BIND_ADDR=127.0.0.1
T3_PORT=3773

# Setup UI: a small page that mints pairing links on demand, so adding a device
# needs neither a shell in the container nor a restart. Guarded by this key.
# Leave it empty and one is generated at boot and printed to the log; set it
# yourself to keep it stable when the container is recreated.
T3_SETUP_KEY=
T3_SETUP_ENABLED=1
T3_SETUP_BIND_ADDR=127.0.0.1
T3_SETUP_PORT=3774
# Mount the setup UI under a path prefix (e.g. /__setup) so a single public
# hostname can route to both services. Leave empty to serve it at the root.
T3_SETUP_BASE_PATH=

# How long links minted by t3-pair and the setup UI stay redeemable.
T3_PAIR_TTL=30d

# --- storage ----------------------------------------------------------------
# Host directory holding your repositories. Every git checkout directly inside
# it is registered as a project on startup.
T3_WORKSPACE_HOST=./workspace

# Own the bind mount correctly: `id -u` and `id -g` on the host.
PUID=1000
PGID=1000
TZ=UTC

# --- behaviour --------------------------------------------------------------
# Which image to run. Locally built: t3code:full or t3code:slim. Published:
# ghcr.io/dizys/t3code-docker:latest (or :slim) - amd64 and arm64.
T3_IMAGE=t3code:full
T3_BUILD_TARGET=full

# Register projects found under /workspace at startup.
T3_AUTO_ADD_PROJECTS=1

# Mint and log a pairing link once the server is healthy. Handy on first run;
# the link is a credential, so it ends up in `docker logs`.
T3_PRINT_PAIRING_ON_START=0

# Key for the DeepSeek-through-OpenCode example (examples/opencode/). Keys for
# Claude, Codex and the rest go in T3 Code's provider settings instead.
DEEPSEEK_API_KEY=

# Let agents install system packages with sudo. Convenient, and it gives an
# agent root inside the container - keep it off unless you want that.
T3_ALLOW_SUDO=0
