#!/bin/bash
# The agent CLIs by name, for `docker exec` and anything else that does not
# have the t3 user's shell environment.
#
# The agents install into the t3 user's persistent home, and that directory is
# deliberately not on the image-wide PATH: root must never resolve a command
# the t3 user can write. So claude, codex, opencode, grok, cursor-agent and muse in
# /usr/local/lib/t3-agents (last on the image PATH) are links to this
# root-owned script. It steps down to t3 (where a sign-in has to land anyway),
# asks the harness manager which exact executable is installed, and runs that.
# It answers where the t3 user's shell setup is absent: root, and a bare
# `docker exec -u t3`. T3 itself never sees it: the entrypoint drops the
# directory from the server's PATH, and login shells never add it.
set -euo pipefail

# Shared root step-down (PATH reset + gosu re-exec): docker/lib/step-down.sh.
# shellcheck source=../lib/step-down.sh
. "${T3_STEP_DOWN_LIB:-/usr/local/lib/t3code}/step-down.sh"

name="$(basename "$0")"
case "$name" in
  claude|codex|opencode|grok|muse) harness="$name" ;;
  cursor-agent) harness=cursor ;;
  *) echo "t3-agent: run this as claude, codex, opencode, grok, cursor-agent or muse" >&2; exit 2 ;;
esac

: "${T3_INFRA_NODE:=/usr/local/bin/node}"
: "${T3_PROVIDER_CLI:=/opt/t3-provider/cli.mjs}"
# shellcheck source=/dev/null
[ -r /etc/profile.d/t3-user-env.sh ] && . /etc/profile.d/t3-user-env.sh

executable="$("$T3_INFRA_NODE" "$T3_PROVIDER_CLI" resolve "$harness" 2>/dev/null || true)"
if [ -z "$executable" ] || [ ! -x "$executable" ]; then
  printf '%s is not installed yet. Install it from Setup > Agents\n' "$name" >&2
  printf 'or run: t3-harness install %s\n' "$harness" >&2
  exit 127
fi
exec "$executable" "$@"
