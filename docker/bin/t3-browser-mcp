#!/bin/bash
# Wire a headless browser into the agent harnesses over MCP.
#
# T3 Code has its own preview_* browser tools, but the server only brokers
# them - a web or desktop client actually hosts the browser. With just a phone
# connected there is no host, so the agent cannot see anything it builds. This
# gives the agent a browser that lives in the container instead.
#
# Registration runs through the managed harness (the same executable T3
# launches), so install the agents first - the first start does by default.
set -euo pipefail

# Shared root step-down (PATH reset + gosu re-exec): docker/lib/step-down.sh.
# shellcheck source=../lib/step-down.sh
. "${T3_STEP_DOWN_LIB:-/usr/local/lib/t3code}/step-down.sh"

# Managed harnesses live in the persistent user tool environment, and the MCP
# config paths hang off the same HOME the managed harness reads. Source it
# before resolving anything.
# shellcheck source=/dev/null
[ -r /etc/profile.d/t3-user-env.sh ] && . /etc/profile.d/t3-user-env.sh
: "${T3_INFRA_NODE:=/usr/local/bin/node}"
: "${T3_PROVIDER_CLI:=/opt/t3-provider/cli.mjs}"

server="playwright"
harnesses="claude,codex,opencode"
action="add"
print_only=0
chromium_path="${CHROME_PATH:-/usr/bin/chromium}"

usage() {
  cat <<'USAGE'
Usage: t3-browser-mcp [--server NAME] [--harness LIST] [--remove] [--print]

  --server NAME    playwright (default) or chrome-devtools
  --harness LIST   comma-separated: claude,codex,opencode (default: all three)
  --remove         unregister instead of registering
  --print          show the command that would be registered and exit

Notes:
  * Chromium is sandboxed by the container already, so --no-sandbox is passed.
  * chrome-devtools-mcp officially supports Google Chrome rather than Debian's
    Chromium; it does work here, but playwright is the tested default.
  * Install the managed harness (setup page or `t3-harness install`) first.
    Claude uses its native CLI; Codex/OpenCode use the setup config adapters.
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --server)  server="${2:?--server needs a value}"; shift 2 ;;
    --harness) harnesses="${2:?--harness needs a value}"; shift 2 ;;
    --remove)  action="remove"; shift ;;
    --print)   print_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 't3-browser-mcp: unknown argument %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

case "$server" in
  playwright)
    name="playwright"
    cmd="playwright-mcp"
    args=(--headless --isolated --no-sandbox --executable-path "$chromium_path")
    ;;
  chrome-devtools)
    name="chrome-devtools"
    cmd="chrome-devtools-mcp"
    # Without --chromeArg=--no-sandbox this launches Chromium and immediately
    # loses it ("Target closed"): it has no sandbox flag of its own.
    args=(--headless --isolated --executablePath "$chromium_path"
          --chromeArg=--no-sandbox --chromeArg=--disable-dev-shm-usage)
    ;;
  *) echo "t3-browser-mcp: unknown server '$server'" >&2; exit 2 ;;
esac

if [ "$print_only" -eq 1 ]; then
  printf '%s' "$cmd"; printf ' %s' "${args[@]}"; printf '\n'
  exit 0
fi

if [ "$action" = "add" ] && ! command -v "$cmd" >/dev/null 2>&1; then
  echo "t3-browser-mcp: $cmd is not installed (it ships in the 'browser' image)" >&2
  exit 1
fi

# The managed executable for a harness when one is runnable, else empty. PATH
# is not consulted: the names there are t3-agent, which resolves the same way.
harness_exec() { # id
  local managed=""
  if [ -r "$T3_PROVIDER_CLI" ] && [ -x "$T3_INFRA_NODE" ]; then
    managed="$("$T3_INFRA_NODE" "$T3_PROVIDER_CLI" resolve "$1" 2>/dev/null || true)"
  fi
  if [ -n "$managed" ] && [ -x "$managed" ]; then
    printf '%s' "$managed"
  fi
}

register_claude() {
  local bin
  bin="$(harness_exec claude)"
  [ -n "$bin" ] || { echo "  claude: not installed"; return; }
  if [ "$action" = "remove" ]; then
    "$bin" mcp remove --scope user "$name" >/dev/null 2>&1 || true
    echo "  claude: removed $name (via $bin)"
  else
    "$bin" mcp remove --scope user "$name" >/dev/null 2>&1 || true
    if "$bin" mcp add --scope user "$name" -- "$cmd" "${args[@]}" >/dev/null 2>&1; then
      echo "  claude: registered $name (via $bin)"
    else
      echo "  claude: FAILED to register $name (via $bin)" >&2
    fi
  fi
}

# Use the console's adapters so both entry points agree on JSONC precedence,
# OpenCode V2 nesting, TOML sections, backups and file symlinks.
write_browser_entry() {
  "$T3_INFRA_NODE" --input-type=module - "$1" "$name" "$action" "$cmd" "${args[@]}" <<'NODE'
import * as io from "node:fs/promises";
const { writeProviderMcpEntry } = await import(process.env.T3_MCP_ADAPTERS_MODULE || "file:///opt/t3-setup/mcp/adapters.mjs");
const [provider, name, action, command, ...args] = process.argv.slice(2);
const entry = action === "remove" ? null : provider === "codex"
  ? { command, args } : { type: "local", command: [command, ...args], enabled: true };
await writeProviderMcpEntry(io, provider, { home: process.env.HOME, env: process.env }, name, entry);
NODE
}

register_codex() {
  local bin
  bin="$(harness_exec codex)"
  [ -n "$bin" ] || { echo "  codex: not installed"; return; }
  write_browser_entry codex
  echo "  codex: $action $name (via $bin)"
}

register_opencode() {
  local bin
  bin="$(harness_exec opencode)"
  [ -n "$bin" ] || { echo "  opencode: not installed"; return; }
  write_browser_entry opencode
  echo "  opencode: $action $name (via $bin)"
}

printf '%s %s (%s)\n' \
  "$([ "$action" = "add" ] && echo Registering || echo Removing)" "$name" "$cmd"

IFS=',' read -ra selected <<< "$harnesses"
for h in "${selected[@]}"; do
  case "$h" in
    claude)   register_claude ;;
    codex)    register_codex ;;
    opencode) register_opencode ;;
    all)      register_claude; register_codex; register_opencode ;;
    "")       ;;
    *) echo "  unknown harness: $h" >&2 ;;
  esac
done

if [ "$action" = "add" ]; then
  printf '\nRestart the thread (or the provider session) for the new tools to appear.\n'
fi
