#!/bin/bash
# Sign a harness in, as the right user.
#
# `docker exec` runs as root, and a harness signed in as root writes its
# credentials to /root - where T3 Code (running as t3) will never find them.
# `t3 connect` is worse: it writes into the state directory itself, so running
# it as root can leave root-owned files (SQLite's -wal and -shm among them)
# that the server, running as t3, then cannot write.
# This runs the login as t3 so everything lands where the server expects it.
#
# When a harness has been installed through the harness manager, the login runs
# that exact mise-managed executable - the same one T3 launches - so credentials
# land in the home the managed harness reads.
set -euo pipefail

# Root runs nothing through the PATH it was handed: under `docker exec` that is
# the container's own, which a container recreated from an older image may have
# carried over (see the entrypoint). The step-down gives it back to t3.
inherited_path="$PATH"
[ "$EUID" -ne 0 ] || PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# T3 runs through the immutable image infrastructure, never a PATH resolution.
: "${T3_INFRA_LAUNCHER:=/usr/local/bin/t3-admin}"
: "${T3_INFRA_NODE:=/usr/local/bin/node}"
# Provider integration resolver.
: "${T3_PROVIDER_CLI:=/opt/t3-provider/cli.mjs}"

if [ "$EUID" -eq 0 ] && command -v gosu >/dev/null 2>&1 && id t3 >/dev/null 2>&1; then
  exec env PATH="$inherited_path" "$(command -v gosu)" t3 "$0" "$@"
fi

# Managed harnesses live in the persistent user tool environment. Source it so
# the resolver inside the module sees the same MISE_* paths the server does.
# shellcheck source=/dev/null
[ -r /etc/profile.d/t3-user-env.sh ] && . /etc/profile.d/t3-user-env.sh

usage() {
  cat <<'USAGE'
Usage: t3-login <harness>

  claude     Claude Code        -> claude auth login
  codex      Codex              -> codex login
  opencode   OpenCode           -> opencode auth login [target] [--method id]
  cursor     Cursor CLI         -> cursor-agent login
  grok       Grok Build         -> grok login
  muse       Muse Code          -> muse login
  connect    T3 Connect         -> t3 connect [command] [options]

Run this with a TTY:  docker compose exec -it t3code t3-login claude
Then enable the provider in T3 Code under Settings > Providers.

OpenCode 2.x takes the integration and method on the command line
(`t3-login opencode anthropic --method key`); with 1.x extra arguments are
left off and the interactive picker runs.

Each agent signs in with its managed executable. Default agents install in
the background on first start; optional agents install from Setup > Agents
or with `t3-harness install <id>`.

`connect` authorizes this environment for T3 Connect. It does not start or
disturb the running server - the link takes effect on T3 Code's next start, so
restart it afterwards: Restart T3 Code under Server on the setup page, or
restart the container. The setup page can also do the whole sign-in itself
(Access -> T3 Connect). For notifications through your own address:
  t3-login connect link --publish-only
USAGE
}

# The managed executable for a harness when one is runnable.
harness_exec() { # id
  local managed=""
  if [ -r "$T3_PROVIDER_CLI" ] && [ -x "$T3_INFRA_NODE" ]; then
    managed="$("$T3_INFRA_NODE" "$T3_PROVIDER_CLI" resolve "$1" 2>/dev/null || true)"
  fi
  if [ -n "$managed" ] && [ -x "$managed" ]; then
    printf '%s' "$managed"
    return 0
  fi
  return 0
}

# Major version of the managed OpenCode release ("1", "2", ...); fails when
# the version cannot be read, so callers can avoid guessing its login syntax.
opencode_major() { # bin
  local out
  out="$(timeout 10s "$1" --version 2>/dev/null | head -1)" || return 1
  if [[ "$out" =~ ([0-9]+)\.[0-9]+\.[0-9]+ ]]; then printf '%s' "${BASH_REMATCH[1]}"; else return 1; fi
}

harness="${1:-}"
case "$harness" in
  claude|codex|opencode|cursor|grok|muse)
    case "$harness" in
      claude)   bin="$(harness_exec claude)";     args=(auth login) ;;
      codex)    bin="$(harness_exec codex)";       args=(login) ;;
      opencode) bin="$(harness_exec opencode)"; args=(auth login) ;;
      # cursor-agent is canonical; the native installer's `agent` alias is
      # never relied on.
      cursor)   bin="$(harness_exec cursor)"; args=(login) ;;
      grok)     bin="$(harness_exec grok)";         args=(login) ;;
      muse)     bin="$(harness_exec muse)";         args=(login) ;;
    esac
    if [ -z "$bin" ]; then
      echo "t3-login: $harness is not installed; install it with t3-harness install $harness" >&2
      exit 1
    fi
    cmd=("$bin" "${args[@]}")
    ;;
  connect)  cmd=("$T3_INFRA_LAUNCHER" connect "${@:2}") ;;
  -h|--help|"") usage; [ -n "$harness" ] && exit 0 || exit 2 ;;
  *) printf 't3-login: unknown harness %s\n\n' "$harness" >&2; usage >&2; exit 2 ;;
esac

# OpenCode 2.x accepts the integration and login flags on the command line;
# 1.x only runs its interactive picker, so extra arguments stay off there.
if [ "$harness" = "opencode" ] && [ "$#" -gt 1 ]; then
  if ! major="$(opencode_major "$bin")"; then
    echo "t3-login: could not check OpenCode’s version; login arguments were not forwarded" >&2
    exit 1
  fi
  if [ "$major" -ge 2 ]; then
    cmd_extra=("${@:2}")
    cmd=("$bin" "${args[@]}" "${cmd_extra[@]}")
  else
    echo "t3-login: OpenCode 1.x takes no login arguments; running the interactive picker" >&2
  fi
fi

if [ ! -t 0 ]; then
  echo "t3-login: no TTY. Re-run with: docker compose exec -it t3code t3-login $harness" >&2
  exit 1
fi

exec "${cmd[@]}"
